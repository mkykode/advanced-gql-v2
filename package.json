  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --watch-preserve-output src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sub:check": "node scripts/sub-check.ts",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "mdx-deck": "^3.0.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/mock": "^9.1.13",
    "@graphql-tools/schema": "^10.1.0",
    "@graphql-tools/utils": "^12.0.0",
    "@mdx-deck/themes": "^3.0.8",
    "cors": "^2.8.6",
    "date-fns": "^2.5.0",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.2.1",
    "jsonwebtoken": "^8.5.1",
    "lowdb": "^1.0.0",
    "nanoid": "^2.1.3",
    "ws": "^8.21.3"
  }
